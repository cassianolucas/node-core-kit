{
  "name": "@cassianolucas/node-core-kit-adapter-node",
  "version": "0.1.0",
  "description": "HTTP adapter for NodeCore built on node:http, with no runtime dependencies",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@cassianolucas/node-core-kit": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "node-core-kit-adapter-contract": "workspace:^",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "tsc --noEmit -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepublishOnly": "yarn build && yarn test",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "nodejs",
    "typescript",
    "http",
    "adapter",
    "nodecore",
    "zero-dependencies"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cassianolucas/node-core-kit.git",
    "directory": "packages/adapter-node"
  },
  "homepage": "https://github.com/cassianolucas/node-core-kit#readme",
  "bugs": {
    "url": "https://github.com/cassianolucas/node-core-kit/issues"
  }
}
